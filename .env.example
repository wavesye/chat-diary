OBSIDIAN_VAULT_PATH=/Users/your-name/Documents/Obsidian/MyVault
OBSIDIAN_JOURNAL_FOLDER="日记/AI 日记"
DIARY_TIMEZONE=Asia/Shanghai
DIARY_USER_NAME=你的名字
DIARY_DB_PATH=data/diary.sqlite

LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# 长期记忆检索：hybrid（FTS5 + 向量）、vector 或 keyword。
# 默认由当前 Python 进程内的 ONNX all-MiniLM-L6-v2 本地生成向量；
# 首次需下载模型，之后可完全离线运行，不需要 Ollama 或 Embedding API。
MEMORY_SEARCH_MODE=hybrid
EMBEDDING_PROVIDER=local
# 可选：本地 ONNX 模型根目录。
# 默认为 ~/.cache/chat-diary/onnx_models/all-MiniLM-L6-v2。
# 作为常驻服务启动时建议使用绝对路径。
# LOCAL_EMBEDDING_CACHE_DIR=/Users/your-name/.cache/chat-diary/onnx_models/all-MiniLM-L6-v2
# ONNX Runtime 使用的线程数，默认 2。
LOCAL_EMBEDDING_THREADS=2
MEMORY_TOP_K=5
# 过滤低相关向量候选；通常无需修改。
MEMORY_VECTOR_MIN_SIMILARITY=0.1
# 如需完全禁用向量，可改为 EMBEDDING_PROVIDER=none，或将检索模式改为 keyword。

# 可选：使用 Ollama 中支持中英文的 Embedding 模型：
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=embeddinggemma
# OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1

# 可选：使用 OpenAI 或其他兼容的 Embedding API：
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# 多聊天渠道：可复制 channels.example.json 为 channels.json，再取消下一行注释。
# 不指定 JSON 时默认只启用 Telegram；JSON 只保存 enabled 开关，凭证在环境变量中。
# CHANNELS_CONFIG=channels.json
# 环境开关优先于 JSON；关闭的渠道无需凭证。
# CHANNEL_TELEGRAM_ENABLED=true
# CHANNEL_WECHAT_ENABLED=false
# CHANNEL_QQ_ENABLED=false
# CHANNEL_LINE_ENABLED=false
# CHANNEL_WHATSAPP_ENABLED=false
# 绑定库默认在 DIARY_DB_PATH 同目录；内部用户使用 UUID，与平台 ID 分离。
# 同时保存 Telegram 待处理消息 inbox 和成功处理记录，请与日记数据一起备份。
# CHANNEL_BINDINGS_DB=data/channel_users.sqlite
# LINE / WhatsApp Webhook 本机监听地址；公网接入需另配 HTTPS 反向代理。
CHANNEL_WEBHOOK_HOST=127.0.0.1
CHANNEL_WEBHOOK_PORT=8080

# Telegram Bot（通过 @BotFather 创建并获取 Token）
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
# 首次可留空，启动 Bot 后发送 /start 获取自己的 user ID，再填回并重启。
# 该 ID 自动绑定到原数据的本地拥有者；更多身份请用 manage_users.py 显式绑定。
TELEGRAM_ALLOWED_USER_ID=
# 连续普通消息在最后一条后静默几秒再合并回复；设为 0 恢复逐条回复。
TELEGRAM_MESSAGE_DEBOUNCE_SECONDS=3

# LINE Messaging API：需官方账号启用 Messaging API，并在控制台创建/获取凭证。
# 回调 URL：https://your-domain.example/webhooks/line
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# WhatsApp Cloud API：需 Meta 应用、WhatsApp Business Account 和业务号码。
# 回调 URL：https://your-domain.example/webhooks/whatsapp
# VERIFY_TOKEN 是自己设定并在 Meta 控制台填入的回调验证字符串。
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 必填：按 Meta 控制台选择支持的 Graph API 版本，格式 vNN.N；不设硬编码默认版本。
WHATSAPP_API_VERSION=

# 微信：TODO Adapter 骨架，当前启用会明确报未实现；先申请所选官方产品的账号和权限。
# 仍需实现官方回调、验签/按需加解密、Token 刷新与文本收发。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# QQ：TODO Adapter 骨架，当前启用会明确报未实现；需 QQ 开放平台机器人和权限。
# 仍需实现 Token 生命周期、事件订阅、验证与文本收发。
QQ_APP_ID=
QQ_APP_SECRET=

# Todo 早晚提醒（使用 DIARY_TIMEZONE；Bot 必须保持运行）
TODO_REMINDERS_ENABLED=true
TODO_MORNING_REMINDER_TIME=08:30
TODO_EVENING_REMINDER_TIME=21:30
# 开启后，非中文且未命中关键词的消息也会用独立模型判断 Todo（每条可能多一次调用）。
TODO_MULTILINGUAL_MODEL_FALLBACK=true

# 历史日记只读导入目录；不配置则不开启导入器。
OBSIDIAN_HISTORY_PATH=/Users/your-name/Documents/Obsidian/MyVault/日记

# 可选：只有明确设置此模型，才允许批量提炼历史长期记忆。
# Base URL 和 Key 留空时继承当前聊天模型配置。
HISTORY_LLM_MODEL=
HISTORY_LLM_BASE_URL=
HISTORY_LLM_API_KEY=

# 使用阿里云百炼 Embedding 的示例：
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-v4

# 也可使用任意 OpenAI-compatible 服务：
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=...
